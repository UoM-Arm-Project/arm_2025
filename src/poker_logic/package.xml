<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>poker_logic</name>
  <version>0.1.0</version>
  <description>Poker decision layer: PokerKit game tracking from vision/buttons, equity bot policy, dealer/player modes, and skill execution on /move_pose + /pump_control.</description>
  <maintainer email="kshitijjha1008@gmail.com">Kshitij</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>poker_interfaces</depend>
  <depend>std_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- pokerkit and treys are pip packages: installed in the workspace .venv (requirements.txt) -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
