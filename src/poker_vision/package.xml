<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>poker_vision</name>
  <version>0.1.0</version>
  <description>Poker vision layer: YOLO card-corner detection with ArUco table frame (overhead camera) and YOLO chip segmentation pot estimate (side camera), publishing to poker_logic.</description>
  <maintainer email="kshitijjha1008@gmail.com">Kshitij</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>poker_interfaces</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- ultralytics / torch / opencv / onnxruntime / tensorrt: pip, in the workspace .venv (requirements.txt) -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
